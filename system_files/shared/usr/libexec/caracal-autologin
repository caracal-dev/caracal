#!/usr/bin/bash
# Configure autologin for the primary user (uid 1000) directly into the
# desktop session. GNOME (gnome.desktop) uses GDM — Bazzite's approach:
# /etc/gdm/custom.conf enables automatic login, and GDM is what provides the
# lock screen for GNOME sessions (SDDM on desktop GNOME breaks screen
# locking). KDE (plasma.desktop, kinoite) uses the SDDM config drop-in;
# plasmalogin ignores SDDM config, so writing it stays harmless on builds
# that run plasmalogin instead.
#
# On fresh ISO installs (no existing human user), creates a bootstrap user
# so the Caracal setup wizard can run. After the wizard creates the real
# user, this script detects the real user and disables autologin so the user
# logs in manually at the greeter.
set -uo pipefail

BOOTSTRAP_USER="caracal"

GDM_CONF="/etc/gdm/custom.conf"
SDDM_CONFIG_DIR="/etc/sddm.conf.d"
SDDM_CONFIG_FILE="${SDDM_CONFIG_DIR}/zz-caracal-autologin.conf"

# Detect desktop session type from installed session files.
session=""
if [[ -f /usr/share/wayland-sessions/gnome.desktop ]]; then
  session="gnome.desktop"
elif [[ -f /usr/share/wayland-sessions/plasma.desktop ]]; then
  session="plasma.desktop"
else
  echo "caracal-autologin: no known session file found; skipping." >&2
  rm -f "${GDM_CONF}" "${SDDM_CONFIG_FILE}"
  exit 0
fi

# Find all real human users (uid >= 1000, excluding the bootstrap user).
real_users=()
while IFS=: read -r name _ uid _; do
  if [[ "$uid" -ge 1000 && "$uid" -lt 65534 && "$name" != "$BOOTSTRAP_USER" ]]; then
    real_users+=("$name")
  fi
done < /etc/passwd

# Stop autologin once the wizard created a real user. Always remove the
# other DM's config first so a DM switch (SDDM-era -> GDM) cannot leave a
# stale autologin behind for the wrong display manager.
rm -f "${SDDM_CONFIG_FILE}"
if [[ "$session" == "gnome.desktop" ]]; then
  # GDM treats the commented template (no automatic login) as disabled.
  sed -i \
    -e 's/.*AutomaticLoginEnable=.*/#AutomaticLoginEnable=False/' \
    -e 's/.*AutomaticLogin=.*/#AutomaticLogin=/' \
    -e 's/.*DefaultSession=.*/#DefaultSession=/' \
    "${GDM_CONF}" 2>/dev/null || true
fi

if [[ ${#real_users[@]} -gt 0 ]]; then
  # Real user(s) exist — setup has completed. Disable autologin so the user
  # signs in manually with their chosen credentials.
  echo "caracal-autologin: real user '${real_users[0]}' exists; disabling autologin."
  exit 0
fi

# No real user yet. Check for an existing bootstrap user.
user="$(id -nu 1000 2>/dev/null || true)"
if [[ -z "${user}" ]]; then
  # No user at all — first boot from ISO. Create a bootstrap account so the
  # display manager can autologin; the Caracal setup wizard will create the
  # real user later.
  echo "caracal-autologin: no human user found; creating bootstrap user '${BOOTSTRAP_USER}'."
  user="${BOOTSTRAP_USER}"
  if ! getent passwd "${user}" >/dev/null; then
    # Ensure audio/realtime groups exist before creating the account
    # (same pattern as caracal-stage-firstboot).
    for grp in wheel audio realtime video render input; do
      getent group "$grp" >/dev/null || groupadd --system "$grp"
    done
    useradd \
      --uid 1000 \
      --groups wheel,audio,realtime,video,render,input \
      --create-home \
      --shell /bin/bash \
      --comment "Caracal OS bootstrap" \
      "${user}"
    # Lock the password so the account cannot be logged into via the greeter
    # (autologin bypasses the greeter).
    passwd --lock "${user}" || true
  fi
fi

if [[ "$session" == "gnome.desktop" ]]; then
  # GDM autologin (Bazzite's gnome-autologin approach). The template ships in
  # system_files/gnome/etc/gdm/; regenerate it if anything removed it so the
  # sed below always has known keys to rewrite.
  if [[ ! -f "${GDM_CONF}" ]]; then
    mkdir -p /etc/gdm
    cat > "${GDM_CONF}" <<'EOF'
# GDM configuration storage

[daemon]
#AutomaticLoginEnable=True
#AutomaticLogin=
#WaylandEnable=False
#DefaultSession=

[security]

[xdmcp]

[chooser]

[debug]
#Enable=true
EOF
  fi
  sed -i \
    -e 's/.*AutomaticLoginEnable=.*/AutomaticLoginEnable=true/' \
    -e "s/.*AutomaticLogin=.*/AutomaticLogin=${user}/" \
    -e 's/.*DefaultSession=.*/DefaultSession=gnome.desktop/' \
    "${GDM_CONF}"
else
  mkdir -p "${SDDM_CONFIG_DIR}"
  cat > "${SDDM_CONFIG_FILE}" <<EOF
# Generated by caracal-autologin.service. Edits are overwritten on boot.
[Autologin]
User=${user}
Session=${session}
EOF
fi

echo "caracal-autologin: autologin configured for '${user}' with '${session}'."