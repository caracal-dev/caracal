#!/usr/bin/bash
# Configure SDDM to autologin the primary user (uid 1000) directly into the
# desktop session. On fresh ISO installs (no existing human user), creates a
# bootstrap user so the Caracal setup wizard can run. After the wizard creates
# the real user, this script detects the real user and disables autologin so
# the user logs in manually at the SDDM greeter.
set -uo pipefail

CONFIG_DIR="/etc/sddm.conf.d"
CONFIG_FILE="${CONFIG_DIR}/zz-caracal-autologin.conf"
BOOTSTRAP_USER="caracal"

# Detect desktop session type from installed session files.
session=""
if [[ -f /usr/share/wayland-sessions/gnome.desktop ]]; then
  session="gnome.desktop"
elif [[ -f /usr/share/wayland-sessions/plasma.desktop ]]; then
  session="plasma.desktop"
else
  echo "caracal-autologin: no known session file found; skipping." >&2
  rm -f "${CONFIG_FILE}"
  exit 0
fi

# Find all real human users (uid >= 1000, excluding the bootstrap user).
real_users=()
while IFS=: read -r name _ uid _; do
  if [[ "$uid" -ge 1000 && "$uid" -lt 65534 && "$name" != "$BOOTSTRAP_USER" ]]; then
    real_users+=("$name")
  fi
done < /etc/passwd

if [[ ${#real_users[@]} -gt 0 ]]; then
  # Real user(s) exist — setup has completed. Disable autologin so the user
  # signs in manually with their chosen credentials.
  echo "caracal-autologin: real user '${real_users[0]}' exists; disabling autologin."
  rm -f "${CONFIG_FILE}"
  exit 0
fi

# No real user yet. Check for an existing bootstrap user.
user="$(id -nu 1000 2>/dev/null || true)"
if [[ -z "${user}" ]]; then
  # No user at all — first boot from ISO. Create a bootstrap account so SDDM
  # can autologin; the Caracal setup wizard will create the real user later.
  echo "caracal-autologin: no human user found; creating bootstrap user '${BOOTSTRAP_USER}'."
  user="${BOOTSTRAP_USER}"
  if ! getent passwd "${user}" >/dev/null; then
    # Ensure audio/realtime groups exist before creating the account
    # (same pattern as caracal-stage-firstboot).
    for grp in wheel audio realtime video render input; do
      getent group "$grp" >/dev/null || groupadd --system "$grp"
    done
    useradd \
      --uid 1000 \
      --groups wheel,audio,realtime,video,render,input \
      --create-home \
      --shell /bin/bash \
      --comment "Caracal OS bootstrap" \
      "${user}"
    # Lock the password so the account cannot be logged into via the greeter
    # (SDDM autologin bypasses the greeter).
    passwd --lock "${user}" || true
  fi
fi

mkdir -p "${CONFIG_DIR}"
cat > "${CONFIG_FILE}" <<EOF
# Generated by caracal-autologin.service. Edits are overwritten on boot.
[Autologin]
User=${user}
Session=${session}
EOF

echo "caracal-autologin: autologin configured for '${user}' with '${session}'."