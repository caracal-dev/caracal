{
    // Caracal Stage Waybar
    // Touch-optimized: bottom bar, 56px height, generous spacing.
    "layer": "bottom",
    "position": "bottom",
    "height": 56,
    "spacing": 8,
    "margin": "0 8 8 8",

    "modules-left": [
        "custom/launcher",
        "wlr/taskbar"
    ],
    "modules-center": [],
    "modules-right": [
        "pulseaudio",
        "custom/keyboard",
        "clock",
        "tray",
        "custom/power"
    ],

    "custom/launcher": {
        "format": "󰣇",
        "tooltip": false,
        "on-click": "wofi -show run"
    },

    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 20,
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close",
        "on-click-right": "minimize"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 {volume}%",
        "format-icons": {
            "default": ["", "", ""]
        },
        "max-volume": 100,
        "scroll-step": 2,
        "on-click": "pavucontrol",
        "on-scroll-up": "wpctl set-volume @DEFAULT_SINK@ 2%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_SINK@ 2%-",
        "on-click-right": "wpctl set-mute @DEFAULT_SINK@ toggle"
    },

    "custom/keyboard": {
        "format": "",
        "tooltip": false,
        "on-click": "sh -c 'pkill -0 wvkbd-mobintl 2>/dev/null && pkill wvkbd-mobintl || wvkbd-mobintl'"
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "{:%a %b %d}",
        "interval": 60
    },

    "tray": {
        "icon-size": 20,
        "spacing": 8
    },

    "custom/power": {
        "format": "",
        "tooltip": false,
        "on-click": "/usr/bin/caracal-stage-wlogout"
    }
}