let {
    $launcher = {
        type = "launcher"
        icon = "/usr/share/pixmaps/caracal.png"
        icon_size = 28
    }

    $focused = {
        type = "focused"
        show_icon = false
        show_title = true
        icon_size = 24
        truncate.mode = "end"
        truncate.max_length = 48
    }

    $volume = {
        type = "volume"
        format = "{icon} {percentage}%"
        max_volume = 100
        icons.volume_high = ""
        icons.volume_medium = ""
        icons.volume_low = ""
        icons.muted = "󰝟"
        on_scroll_down = "wpctl set-volume @DEFAULT_SINK@ 2%-"
        on_scroll_up = "wpctl set-volume @DEFAULT_SINK@ 2%+"
    }

    $keyboard = {
        type = "custom"
        bar = [
            {
                type = "button"
                name = "keyboard"
                class = "keyboard"
                label = ""
                on_click = "!pkill -0 wvkbd-mobintl 2>/dev/null && pkill wvkbd-mobintl || wvkbd-mobintl"
            }
        ]
    }

    $clock = {
        type = "clock"
        format = "%H:%M"
        format_alt = "%a %b %d"
        interval = 60
    }

    $tray = { type = "tray" }

    $power = {
        type = "custom"
        bar = [
            {
                type = "button"
                name = "power"
                class = "power"
                label = ""
                on_click = "!/usr/bin/caracal-stage-wlogout"
            }
        ]
    }
}

in {
    icon_theme = "Adwaita"
    position = "bottom"
    start = [ $launcher $focused ]
    center = [ ]
    end = [ $volume $keyboard $clock $tray $power ]
}