#!/usr/bin/bash
# Configure greetd to autologin the primary (uid 1000) user directly into the Caracal Stage Wayfire/Carla session.
set -euo pipefail

CONFIG=/etc/greetd/config.toml
SESSION=/usr/bin/caracal-stage-session

ensure_greeter_user() {
  if ! getent group greeter >/dev/null; then
    groupadd --system greeter
  fi

  if ! getent passwd greeter >/dev/null; then
    useradd --system --no-create-home --home-dir /var/lib/greetd \
      --shell /usr/sbin/nologin --comment "greetd greeter" \
      --gid greeter greeter
  fi

  if getent group video >/dev/null; then
    usermod -aG video greeter
  fi

  install -d -o greeter -g greeter -m 0755 /var/lib/greetd
}

user="$(id -nu 1000 2>/dev/null || true)"

ensure_greeter_user
mkdir -p "$(dirname "${CONFIG}")"

{
  echo "# Generated by caracal-stage-autologin.service. Edits are overwritten on boot."
  echo
  echo "[terminal]"
  echo "vt = 1"
  echo
  echo "[default_session]"
  echo "command = \"agreety --cmd ${SESSION}\""
  echo "user = \"greeter\""
  if [[ -n "${user}" ]]; then
    echo
    echo "[initial_session]"
    echo "command = \"${SESSION}\""
    echo "user = \"${user}\""
  fi
} >"${CONFIG}"

if [[ -n "${user}" ]]; then
  echo "caracal-stage-autologin: autologin configured for '${user}'."
else
  echo "caracal-stage-autologin: no uid-1000 user yet; using agreety greeter." >&2
fi
