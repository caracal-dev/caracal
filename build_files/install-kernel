#!/usr/bin/bash
# Replaces the stock Fedora kernel with the OGC/Bazzite kernel.
# RPMs are provided by the ublue-os/akmods OCI image's /kernel-rpms payload,
# mounted at /rpms/kernel during the container build step.
#
# Adapted from https://github.com/ublue-os/bazzite (Apache 2.0)

set -eoux pipefail

# Disable kernel-install hooks to prevent dracut/rpm-ostree from triggering
# inside the container build environment. rpm-ostree hooks only exist on the
# ostree-desktop bases (kinoite/silverblue); the generic fedora-bootc base has
# no 05-rpmostree.install, so tolerate missing hooks and restore only what was
# replaced (no-op stubs must not leak into the final image, where they would
# disable real kernel-install work on the deployed system).
pushd /usr/lib/kernel/install.d
for hook in 05-rpmostree.install 50-dracut.install; do
    if [[ -f "${hook}" ]]; then
        mv "${hook}" "${hook}.bak"
        printf '%s\n' '#!/bin/sh' 'exit 0' > "${hook}"
        chmod +x "${hook}"
    fi
done
popd

# Remove the stock Fedora kernel RPMs
for pkg in kernel kernel-core kernel-modules kernel-modules-core kernel-modules-extra kernel-modules-akmods kernel-common kernel-tools-libs kernel-tools kernel-nvidia kernel-nvidia-closed-lts; do
    rpm --erase "${pkg}" --nodeps || true
done

# Remove all kernel module directories so no orphaned versions remain
rm -rf /usr/lib/modules

# Install kernel RPMs from the mounted OCI image.
# The glob pattern matches versioned RPM filenames.
required_pkgs=(
    kernel
    kernel-core
    kernel-modules
)

optional_pkgs=(
    kernel-modules-core
    kernel-modules-extra
    kernel-modules-akmods
    kernel-devel
    kernel-devel-matched
    kernel-tools
    kernel-tools-libs
    kernel-common
)

PKG_PAT=()
installed_pkgs=()
shopt -s nullglob
for pkg in "${required_pkgs[@]}"; do
    matches=("/rpms/kernel/${pkg}-"[0-9]*)
    if [[ "${#matches[@]}" -eq 0 ]]; then
        echo "Required kernel RPM not found: ${pkg}" >&2
        exit 1
    fi
    PKG_PAT+=("${matches[@]}")
    installed_pkgs+=("${pkg}")
done

for pkg in "${optional_pkgs[@]}"; do
    matches=("/rpms/kernel/${pkg}-"[0-9]*)
    if [[ "${#matches[@]}" -gt 0 ]]; then
        PKG_PAT+=("${matches[@]}")
        installed_pkgs+=("${pkg}")
    fi
done
shopt -u nullglob

# versionlock comes from dnf5-plugins; the generic fedora-bootc base does not
# ship it (the ostree-desktop bases do, where this install is a no-op).
dnf5 -y install dnf5-plugins

dnf5 -y install "${PKG_PAT[@]}"
dnf5 versionlock add "${installed_pkgs[@]}"

# Restore the original kernel-install hooks; hooks that did not exist on the
# base (05-rpmostree.install on fedora-bootc) leave no stub behind.
pushd /usr/lib/kernel/install.d
for hook in 05-rpmostree.install 50-dracut.install; do
    if [[ -f "${hook}.bak" ]]; then
        mv -f "${hook}.bak" "${hook}"
    else
        rm -f "${hook}"
    fi
done
popd

# Clear any kernel files the RPM dropped in /boot — atomic images manage
# /boot via the bootloader layer.
rm -rf /boot/*

# === Secure Boot support ===
# Download the ublue akmods public key (MOK certificate) so pre-signed kernel
# modules can be loaded with Secure Boot enabled. Users must enroll this key
# via MOK during first boot — see README for instructions.
install -d -m 0755 /etc/pki/akmods/certs
curl -sSL --retry 3 \
  "https://github.com/ublue-os/akmods/raw/refs/heads/main/certs/public_key.der" \
  -o /etc/pki/akmods/certs/akmods-ublue.der
chmod 0644 /etc/pki/akmods/certs/akmods-ublue.der
