#!/usr/bin/bash
# Build initramfs after all branding and system file changes are present so
# Plymouth assets inside the early boot image match the final rootfs.
#
# Adapted from https://github.com/ublue-os/bazzite (Apache 2.0)

set -eoux pipefail

KVER="$(ls /usr/lib/modules | head -n1)"
dracut \
    --reproducible \
    --no-hostonly \
    --add "ostree" \
    --zstd \
    --force \
    "/usr/lib/modules/${KVER}/initramfs.img" \
    "${KVER}"

# === Bootupd update metadata ===
# Regenerate bootupd's bootloader metadata AFTER the kernel swap above: the
# metadata inherited from the Kinoite base was generated against the stock
# Fedora kernel. Anaconda installs bootc payloads through bootupctl, and with
# stale metadata the bootloader step fails on UEFI bare metal ("failed to
# write boot loader configuration" — jasonn3/build-container-installer#127).
# The package is already present; this only refreshes the metadata.
bootupctl backend generate-update-metadata

chmod 0600 "/usr/lib/modules/${KVER}/initramfs.img"
